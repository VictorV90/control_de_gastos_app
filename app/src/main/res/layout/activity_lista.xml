<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:fitsSystemWindows="true"
    tools:context=".ListaActivity">

    <!-- Barra superior: título + 2 botones -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layBarraSuperior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/fondo_tarjeta"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTituloLista"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/titulo_lista"
            android:textColor="@color/colorPrimary"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnAgregarGasto"
            app:layout_constraintWidth_max="320dp"
            style="@style/BotonPrincipal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_agregar_gasto"
            app:layout_constraintTop_toBottomOf="@id/txtTituloLista"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnIrIa" />

        <Button
            android:id="@+id/btnIrIa"
            app:layout_constraintWidth_max="320dp"
            style="@style/BotonPrincipal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_ir_ia"
            app:layout_constraintTop_toTopOf="@id/btnAgregarGasto"
            app:layout_constraintStart_toEndOf="@id/btnAgregarGasto"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Lista desplazable -->
    <ScrollView
        android:id="@+id/scrGastos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layBarraSuperior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtTotalMes"
                style="@style/Etiqueta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/txt_total_mes"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Gasto 1 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layGasto1"
                style="@style/TarjetaGasto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/txtTotalMes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/txtNombreGasto1"
                    style="@style/TextoNombreGasto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/gasto1_nombre"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/txtMontoGasto1" />

                <TextView
                    android:id="@+id/txtMontoGasto1"
                    style="@style/TextoMontoGasto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gasto1_monto"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtCategoriaGasto1"
                    style="@style/TextoSecundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/gasto1_categoria"
                    app:layout_constraintTop_toBottomOf="@id/txtNombreGasto1"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/txtFechaGasto1"
                    style="@style/TextoSecundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gasto1_fecha"
                    app:layout_constraintTop_toTopOf="@id/txtCategoriaGasto1"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Gasto 2 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layGasto2"
                style="@style/TarjetaGasto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/layGasto1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/txtNombreGasto2"
                    style="@style/TextoNombreGasto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/gasto2_nombre"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/txtMontoGasto2" />

                <TextView
                    android:id="@+id/txtMontoGasto2"
                    style="@style/TextoMontoGasto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gasto2_monto"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtCategoriaGasto2"
                    style="@style/TextoSecundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/gasto2_categoria"
                    app:layout_constraintTop_toBottomOf="@id/txtNombreGasto2"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/txtFechaGasto2"
                    style="@style/TextoSecundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gasto2_fecha"
                    app:layout_constraintTop_toTopOf="@id/txtCategoriaGasto2"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Gasto 3 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layGasto3"
                style="@style/TarjetaGasto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/layGasto2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/txtNombreGasto3"
                    style="@style/TextoNombreGasto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/gasto3_nombre"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/txtMontoGasto3" />

                <TextView
                    android:id="@+id/txtMontoGasto3"
                    style="@style/TextoMontoGasto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gasto3_monto"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtCategoriaGasto3"
                    style="@style/TextoSecundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/gasto3_categoria"
                    app:layout_constraintTop_toBottomOf="@id/txtNombreGasto3"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/txtFechaGasto3"
                    style="@style/TextoSecundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gasto3_fecha"
                    app:layout_constraintTop_toTopOf="@id/txtCategoriaGasto3"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Gasto 4 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layGasto4"
                style="@style/TarjetaGasto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/layGasto3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/txtNombreGasto4"
                    style="@style/TextoNombreGasto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/gasto4_nombre"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/txtMontoGasto4" />

                <TextView
                    android:id="@+id/txtMontoGasto4"
                    style="@style/TextoMontoGasto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gasto4_monto"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtCategoriaGasto4"
                    style="@style/TextoSecundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/gasto4_categoria"
                    app:layout_constraintTop_toBottomOf="@id/txtNombreGasto4"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/txtFechaGasto4"
                    style="@style/TextoSecundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gasto4_fecha"
                    app:layout_constraintTop_toTopOf="@id/txtCategoriaGasto4"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>