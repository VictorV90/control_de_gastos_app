<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp">

        <!-- Logo de la app -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/desc_logo"
            android:src="@drawable/cntrl_gastos"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/colorPrimary" />

        <!-- Nombre de la app -->
        <TextView
            android:id="@+id/txtNombreApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/texto_principal"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imgLogo" />

        <!-- Campo de Correo -->
        <EditText
            android:id="@+id/edtCorreo"
            app:layout_constraintWidth_max="488dp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="32dp"
            android:autofillHints="emailAddress"
            android:background="@color/fondo_tarjeta"
            android:hint="@string/hint_correo"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtNombreApp" />

        <!-- Campo de Contraseña -->
        <EditText
            android:id="@+id/edtContrasena"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:autofillHints="password"
            android:background="@color/fondo_tarjeta"
            android:hint="@string/hint_contraseña"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edtCorreo"
            app:layout_constraintWidth_max="488dp" />

        <!-- Botón Ingresar -->
        <Button
            android:id="@+id/btnIngresar"
            style="@style/BotonPrincipal"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginTop="32dp"
            android:text="@string/btn_ingresar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edtContrasena"
            app:layout_constraintWidth_max="320dp" />

        <!-- Botón secundario para ir a Registro -->
        <Button
            android:id="@+id/btnIrRegistro"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/btn_ir_registro"
            android:textColor="@color/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnIngresar" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>