<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:fillViewport="true"
    tools:context=".DetalleActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTituloDetalle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/titulo_detalle"
            android:textColor="@color/colorPrimary"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Tarjeta con el gasto -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layDetalleGasto"
            style="@style/TarjetaGasto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/txtTituloDetalle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtDetalleNombre"
                style="@style/TextoNombreGasto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/gasto1_nombre"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtDetalleMonto"
                style="@style/TextoMontoGasto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/gasto1_monto"
                android:textSize="28sp"
                app:layout_constraintTop_toBottomOf="@id/txtDetalleNombre"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txtEtiquetaCategoriaDetalle"
                style="@style/Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/lbl_categoria"
                app:layout_constraintTop_toBottomOf="@id/txtDetalleMonto"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txtDetalleCategoria"
                style="@style/TextoSecundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gasto1_categoria"
                app:layout_constraintTop_toBottomOf="@id/txtEtiquetaCategoriaDetalle"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txtEtiquetaFechaDetalle"
                style="@style/Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/lbl_fecha"
                app:layout_constraintTop_toBottomOf="@id/txtDetalleCategoria"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txtDetalleFecha"
                style="@style/TextoSecundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gasto1_fecha"
                app:layout_constraintTop_toBottomOf="@id/txtEtiquetaFechaDetalle"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txtEtiquetaMedioPagoDetalle"
                style="@style/Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/lbl_medio_pago_detalle"
                app:layout_constraintTop_toBottomOf="@id/txtDetalleFecha"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txtDetalleMedioPago"
                style="@style/TextoSecundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detalle_medio_pago"
                app:layout_constraintTop_toBottomOf="@id/txtEtiquetaMedioPagoDetalle"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txtEtiquetaNotaDetalle"
                style="@style/Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/lbl_nota_detalle"
                app:layout_constraintTop_toBottomOf="@id/txtDetalleMedioPago"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txtDetalleNota"
                style="@style/TextoSecundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/detalle_nota"
                app:layout_constraintTop_toBottomOf="@id/txtEtiquetaNotaDetalle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtEtiquetaEstado"
                style="@style/Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/lbl_estado"
                app:layout_constraintTop_toBottomOf="@id/txtDetalleNota"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txtDetalleEstado"
                style="@style/TextoSecundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detalle_estado"
                app:layout_constraintTop_toBottomOf="@id/txtEtiquetaEstado"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Acciones -->
        <Button
            android:id="@+id/btnEditarGasto"
            style="@style/BotonPrincipal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_editar_gasto"
            app:layout_constraintWidth_max="320dp"
            app:layout_constraintTop_toBottomOf="@id/layDetalleGasto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnMarcarRevisado"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_marcar_revisado"
            app:layout_constraintWidth_max="320dp"
            app:layout_constraintTop_toBottomOf="@id/btnEditarGasto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnEliminarGasto"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_eliminar_gasto"
            android:textColor="@color/color_gasto"
            app:layout_constraintWidth_max="320dp"
            app:layout_constraintTop_toBottomOf="@id/btnMarcarRevisado"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>