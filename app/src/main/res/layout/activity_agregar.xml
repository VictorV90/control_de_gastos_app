<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:fillViewport="true"
    tools:context=".AgregarActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTituloAgregar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/titulo_agregar"
            android:textColor="@color/colorPrimary"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Descripción -->
        <TextView
            android:id="@+id/txtEtiquetaNombre"
            style="@style/Etiqueta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/lbl_nombre_gasto"
            app:layout_constraintTop_toBottomOf="@id/txtTituloAgregar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/edtNombreGasto"
            style="@style/CampoFormulario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nombre_gasto"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            app:layout_constraintTop_toBottomOf="@id/txtEtiquetaNombre"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Monto -->
        <TextView
            android:id="@+id/txtEtiquetaMonto"
            style="@style/Etiqueta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lbl_monto"
            app:layout_constraintTop_toBottomOf="@id/edtNombreGasto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/edtMonto"
            style="@style/CampoFormulario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/hint_monto"
            android:importantForAutofill="no"
            android:inputType="number"
            app:layout_constraintTop_toBottomOf="@id/txtEtiquetaMonto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Fecha -->
        <TextView
            android:id="@+id/txtEtiquetaFecha"
            style="@style/Etiqueta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lbl_fecha"
            app:layout_constraintTop_toBottomOf="@id/edtMonto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/edtFecha"
            style="@style/CampoFormulario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/hint_fecha"
            android:importantForAutofill="no"
            android:inputType="date"
            app:layout_constraintTop_toBottomOf="@id/txtEtiquetaFecha"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Categoría -->
        <TextView
            android:id="@+id/txtEtiquetaCategoria"
            style="@style/Etiqueta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lbl_categoria"
            app:layout_constraintTop_toBottomOf="@id/edtFecha"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Spinner
            android:id="@+id/spnCategoria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:entries="@array/categorias"
            app:layout_constraintTop_toBottomOf="@id/txtEtiquetaCategoria"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Medio de pago -->
        <TextView
            android:id="@+id/txtEtiquetaMedioPago"
            style="@style/Etiqueta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lbl_medio_pago"
            app:layout_constraintTop_toBottomOf="@id/spnCategoria"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <RadioGroup
            android:id="@+id/rgMedioPago"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/txtEtiquetaMedioPago"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RadioButton
                android:id="@+id/rbEfectivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rb_efectivo"
                android:textColor="@color/texto_principal"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbDebito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rb_debito"
                android:textColor="@color/texto_principal"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbCredito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rb_credito"
                android:textColor="@color/texto_principal"
                android:textSize="16sp" />
        </RadioGroup>

        <!-- Nota -->
        <TextView
            android:id="@+id/txtEtiquetaNota"
            style="@style/Etiqueta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lbl_nota"
            app:layout_constraintTop_toBottomOf="@id/rgMedioPago"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/edtNota"
            style="@style/CampoFormulario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/hint_nota"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            app:layout_constraintTop_toBottomOf="@id/txtEtiquetaNota"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botones -->
        <Button
            android:id="@+id/btnGuardarGasto"
            style="@style/BotonPrincipal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_guardar_gasto"
            app:layout_constraintWidth_max="320dp"
            app:layout_constraintTop_toBottomOf="@id/edtNota"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnCancelarGasto"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_cancelar"
            app:layout_constraintWidth_max="320dp"
            app:layout_constraintTop_toBottomOf="@id/btnGuardarGasto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>