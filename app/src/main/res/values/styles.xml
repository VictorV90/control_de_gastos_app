<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TarjetaGasto">
        <item name="android:background">@color/fondo_tarjeta</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="TextoNombreGasto">
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextoMontoGasto">
        <item name="android:textColor">@color/color_gasto</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextoSecundario">
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Etiqueta">
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CampoFormulario">
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textColorHint">@color/texto_secundario</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@color/fondo_tarjeta</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="layout_constraintWidth_max">488dp</item>
    </style>
</resources>